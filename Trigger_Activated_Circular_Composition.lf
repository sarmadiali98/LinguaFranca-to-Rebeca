target Cpp
reactor Node(id: int = 0) {
    input recievedMsg: int;
    output msg: int;
    reaction(startup) -> msg {=
        if(id==0){
            msg.set(1);
        }
        reactor::log::Info()<<"First message sent";
    =}
    reaction(recievedMsg) -> msg {=
        msg.set(1);
        reactor::log::Info() << "Message recieved on node: " << id;
    =}
}
main reactor{
    node0 = new Node(id = 0);
    node1 = new Node(id = 1);
    node2 = new Node(id = 2);
    node3 = new Node(id = 3);
    node0.msg -> node1.recievedMsg;
    node1.msg -> node2.recievedMsg;
    node2.msg -> node3.recievedMsg;
    node3.msg -> node0.recievedMsg after 0;
}