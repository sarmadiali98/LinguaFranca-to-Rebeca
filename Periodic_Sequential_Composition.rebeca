reactiveclass Node(100) {
    knownrebecs {
        Node next;
    }
    statevars {
	boolean islast;
	int id;
    }
    Node(boolean _islast,int _id){
        id = _id;
        islast = _islast;
        if(!islast){
            self.sendMsg(1);
        }
    }
    @priority(1)
    msgsrv sendMsg(int msg) {
        next.rcvMsg(msg);
        self.sendMsg(msg)after(1);
    }
    @priority(2)
    msgsrv rcvMsg(int msg) {}
}
main {
    Node node0(node1):(true, 0);
    Node node1(node2):(false, 1);
    Node node2(node3):(false, 2);
    Node node3(node3):(false, 3);
}